+  test("local host review binds executable plugin installation to the exact package fingerprint", async () => {
+    const lifecycle = await import("./plugin-package-lifecycle.js");
+    const workspaceRoot = await createRoot("ipollowork-plugin-local-review-");
+    const packageRoot = join(workspaceRoot, "package");
+    process.env.IPOLLOWORK_RUNTIME_DB = join(workspaceRoot, "runtime.sqlite");
+    await writeDeclarativePackage(packageRoot);
+    const manifestPath = join(packageRoot, "ipollowork.plugin.json");
+    const manifest = JSON.parse(await readFile(manifestPath, "utf8"));
+    manifest.permissions = [{ id: "process", reason: "Start the reviewed local service" }];
+    manifest.resources.push({ type: "local-service", id: "service", path: "service/local.mjs",
+      provides: ["action:ping"], actions: [{ id: "ping", title: "Ping", description: "Read the local service status", effect: "read", inputSchema: { type: "object" } }] });
+    await mkdir(join(packageRoot, "service"), { recursive: true });
+    await writeFile(join(packageRoot, "service/local.mjs"), "export default async () => ({actions:{ping:async()=>({pong:true})}})");
+    await writeFile(manifestPath, JSON.stringify(manifest));
+    const preview = await lifecycle.previewPluginPackage({ packageRoot, engineId: ENGINE_ID });
+    const files = await Promise.all([...new Set(["ipollowork.plugin.json", ...preview.files.map(file => file.path)])].map(async path => ({
+      path, contentBase64: (await readFile(join(packageRoot, path))).toString("base64"),
+    })));
+    const upload = { archiveName: "local.ipollowork-plugin", files };
+    const server = await startServer(serverConfig(workspaceRoot));
+    const base = `http://127.0.0.1:${server.port}/workspace/${WORKSPACE_ID}/plugin-packages/import`;
+    const headers = { authorization: "Bearer token", "content-type": "application/json" };
+    const hostHeaders = { ...headers, "x-ipollowork-host-token": "host-token" };
+    const request = (url: string, body: unknown, authenticatedHost = false) => fetch(url, {
+      method: "POST", headers: authenticatedHost ? hostHeaders : headers, body: JSON.stringify(body),
+    });
+    try {
+      expect((await request(`${base}/validate`, upload)).status).toBe(400);
+      const reviewed = await request(`${base}/validate`, upload, true);
+      expect(reviewed.status).toBe(200);
+      const result = await reviewed.json();
+      expect(result.preview.safety).toMatchObject({ level: "local-review", status: "required", sha256: preview.integrity.sha256 });
+      expect((await request(base, upload, true)).status).toBe(400);
+      expect((await request(base, { ...upload, localReviewSha256: preview.integrity.sha256 })).status).toBe(403);
+      expect((await request(base, { ...upload, localReviewSha256: "0".repeat(64) }, true)).status).toBe(409);
+      const approved = await request(base, { ...upload, localReviewSha256: preview.integrity.sha256 }, true);
+      expect(approved.status).toBe(200);
+      expect(await approved.json()).toMatchObject({ result: { status: "installed" }, safety: { level: "local-review", status: "approved" } });
+      const changedFiles = files.map(file => file.path === "service/local.mjs"
+        ? { ...file, contentBase64: Buffer.from("export default async () => ({actions:{}})").toString("base64") } : file);
+      expect((await request(base, { ...upload, files: changedFiles, localReviewSha256: preview.integrity.sha256 }, true)).status).toBe(409);
+    } finally { await server.stop(); }
+  });
