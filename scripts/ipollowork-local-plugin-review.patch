   | {
       level: "declarative";
       localCode: false;
@@ -1179,6 +1186,8 @@ export async function assertPluginPackageSafeForImport(input: {
   packageRoot: string;
   preview: PluginPackagePreview;
   purpose: PluginPackageImportPurpose;
+  previewLocalReview?: boolean;
+  localReviewSha256?: string;
 }): Promise<PluginPackageImportSafety> {
   const { manifest } = input.preview;
   const reasons: string[] = [];
@@ -1187,6 +1196,26 @@ export async function assertPluginPackageSafeForImport(input: {
     const signedSafety = signedImportSafety(manifest, input.preview.integrity);
     if (signedSafety) return signedSafety;
   }
+  // Only the authenticated local host can request this path at the upload API.
+  // Approval belongs to these exact bytes, never to an ID or publisher name.
+  if (!manifest.source.trusted && input.purpose === "install"
+      && (input.previewLocalReview || input.localReviewSha256 !== undefined)) {
+    const reviewedTypes = new Set([...SAFE_IMPORT_RESOURCE_TYPES, "local-service"]);
+    const reviewedPermissions = new Set(["network", "workspace-read", "workspace-write", "process", "clipboard", "notifications"]);
+    const unsupported = Boolean(manifest.engineBindings?.length || manifest.authorization?.methods.length)
+      || manifest.resources.some((resource) => !reviewedTypes.has(resource.type))
+      || manifest.permissions?.some((permission) => !reviewedPermissions.has(permission.id));
+    if (unsupported) throw new ApiError(400, "plugin_package_import_unsafe", "Local review does not allow engine bindings, native binaries, authorization forms, or device permissions");
+    const needsReview = hasExecutableCapabilities(manifest) || Boolean(manifest.permissions?.length)
+      || manifest.resources.some((resource) => resource.path && !safeImportResourcePath(resource.type, resource.path));
+    if (needsReview) {
+      if (input.localReviewSha256 !== undefined && input.localReviewSha256 !== input.preview.integrity.sha256)
+        throw new ApiError(409, "plugin_package_review_changed", "The package changed after review. Preview it and approve the new fingerprint.");
+      return { level: "local-review", localCode: hasExecutableCapabilities(manifest),
+        status: input.localReviewSha256 ? "approved" : "required", sha256: input.preview.integrity.sha256,
+        allowedResourceTypes: [...new Set(manifest.resources.map((resource) => resource.type))] };
+    }
+  }
   if (hasExecutableCapabilities(manifest)) {
     reasons.push("Imported packages cannot include executable capabilities");
   }
