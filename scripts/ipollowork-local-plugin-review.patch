+const install = `([...document.querySelectorAll('[role="dialog"] button')].find(b => ['安装插件', '更新'].includes(b.textContent?.trim())))`;
+let workspaceId;
+
+export default {
+  id: 'muweave-plugin-review', title: '明确审批本地插件后在 iPolloWork 打开幕织 Studio', kind: 'user-facing', preserveTheme: true,
+  requiredEnv: ['IPOLLOWORK_EVAL_MUWEAVE_PACKAGE'],
+  steps: [
+    { name: '未审批的可执行插件无法安装', async run(ctx) {
+      await ctx.prove('幕织展示文件指纹与本地服务审批，安装按钮默认禁用', {
+        voiceover: vo[0],
+        action: async () => {
+          await ctx.waitFor('Boolean(window.__ipolloworkControl)');
+          await ctx.eval(`document.querySelector('[role="dialog"]') && ${button('取消')}?.click()`);
+          await ctx.waitFor('!document.querySelector(\'[role="dialog"]\')');
+          workspaceId = await ctx.eval('location.hash.split("/")[2]');
+          ctx.assert(workspaceId?.startsWith('ws_'), 'A local workspace is required.');
+          await ctx.navigateHash(`/workspace/${workspaceId}/settings/extensions`);
+          await ctx.waitFor('window.__ipolloworkControl.snapshot().route.endsWith("/settings/extensions")');
+          await ctx.waitFor(`(() => {
+            const input = document.querySelector('input[type="file"][accept*=".ipollowork-plugin"]');
+            if (input) return true;
+            ${button('添加')}?.click();
+            return false;
+          })()`);
+          const { root } = await ctx.client.send('DOM.getDocument', { depth: 1, pierce: true });
+          const { nodeId } = await ctx.client.send('DOM.querySelector', { nodeId: root.nodeId,
+            selector: 'input[type="file"][accept*=".ipollowork-plugin"]' });
+          await ctx.client.send('DOM.setFileInputFiles', { nodeId, files: [resolve(process.env.IPOLLOWORK_EVAL_MUWEAVE_PACKAGE)] });
+          await ctx.waitFor('Boolean(document.querySelector(\'[data-testid="plugin-local-review-fingerprint"]\'))', { timeoutMs: 60000 });
+          await ctx.eval(`${checkbox}.scrollIntoView({block:"center"})`);
+        },
+        assert: async () => {
+          ctx.assert(await ctx.eval(`${checkbox}?.getAttribute('aria-checked') === 'false'`), 'Review must start unchecked.');
+          ctx.assert(await ctx.eval(`${install}?.disabled === true`), 'Unapproved installation must be disabled.');
+          ctx.assert(await ctx.eval('document.body.innerText.includes("service/muweave.mjs")'), 'Service source must be available.');
+          ctx.assert(await ctx.eval('/SHA-256: [a-f0-9]{64}/.test(document.body.innerText)'), 'Exact package fingerprint must be shown.');
+        },
+        screenshot: { name: 'approval-required', requireText: ['SHA-256:', '审批此本地插件', 'service/muweave.mjs'] },
+      });
+    } },
+    { name: '明确审批安装对应的插件包', async run(ctx) {
+      await ctx.prove('审批后真实安装幕织插件', {
+        voiceover: vo[1],
+        action: async () => {
+          await ctx.eval(`${checkbox}.click()`);
+          await ctx.waitFor(`${install}?.disabled === false`);
+          await ctx.eval(`${install}.click()`);
+          await ctx.waitFor('!document.querySelector(\'[role="dialog"]\')', { timeoutMs: 60000 });
+          await ctx.waitFor('document.body.innerText.includes("幕织 Studio")', { timeoutMs: 60000 });
+        },
+        assert: async () => {
+          const installed = await ctx.eval(`(async () => {
+            const info = await window.__IPOLLOWORK_ELECTRON__.invokeDesktop('ipolloworkServerInfo');
+            const response = await fetch(info.baseUrl + '/workspace/' + ${JSON.stringify(workspaceId)} + '/plugin-packages', {
+              headers: { authorization: 'Bearer ' + (info.ownerToken || info.clientToken), 'X-iPolloWork-Host-Token': info.hostToken },
+            });
+            if (!response.ok) throw Error('Installed catalog HTTP ' + response.status);
+            const item = (await response.json()).items.find(item => item.pluginId === 'muweave');
+            return { installed: Boolean(item), version: item?.version, enabled: item?.enabled };
+          })()`, { awaitPromise: true });
+          ctx.assert(installed.installed && /^0\.2\.\d+$/.test(installed.version) && installed.enabled !== false, 'Approved package must be installed and enabled.');
+        },
+        screenshot: { name: 'approved-installed', requireText: ['幕织 Studio', '已安装'] },
+      });
+    } },
+    { name: '使用真实嵌入 Studio', async run(ctx) {
+      await ctx.navigateHash(`/workspace/${workspaceId}/session`);
+      await ctx.waitFor('window.__ipolloworkControl.listActions().some(a => a.id === "session.create_task" && !a.disabled)');
+      await ctx.control('session.create_task');
+      const launcher = `document.querySelector('[aria-label="添加侧面板入口"]')`;
+      const entry = `document.querySelector('[data-testid="side-panel-launcher-workspace-app:muweave:workspace-app:studio"]')`;
+      const frame = `document.querySelector('iframe[title="幕织 Studio"]')`;
+      await ctx.waitFor(`Boolean(${launcher}) || Boolean(document.querySelector('[aria-label="打开右侧面板"]'))`);
+      await ctx.eval(`document.querySelector('[aria-label="打开右侧面板"]')?.click()`);
+      await ctx.waitFor(`Boolean(${launcher})`, { timeoutMs: 60000 });
+      await ctx.eval(`${launcher}.click()`);
+      await ctx.waitFor(`Boolean(${entry})`);
+      await ctx.eval(`${entry}.click()`);
+      await ctx.waitFor(`Boolean(${frame}?.contentDocument?.querySelector('.app-shell'))`, { timeoutMs: 60000 });
+      await ctx.eval(`${frame}.contentDocument.querySelector('[aria-label="项目导航"]')?.click()`);
+      const text = await ctx.eval(`${frame}.contentDocument.body.innerText`);
+      await ctx.eval(`${frame}.contentDocument.querySelector('.studio-navigation-open button[aria-label="关闭项目导航"]')?.click()`);
+      await ctx.eval(`${frame}.contentDocument.querySelector('[aria-label="项目导航"][aria-expanded="true"]')?.click()`);
+      await ctx.eval(`document.querySelector('[aria-label="Expand panel"]')?.click()`);
+      await ctx.waitFor(`${frame}.getBoundingClientRect().width > 600`);
+        await ctx.prove('iPolloWork 加载幕织真实 Studio 与本机项目库', {
+          voiceover: vo[2],
+          assert: async () => {
+            ctx.assert(text.includes('MUWEAVE STUDIO') && text.includes('新建项目'), 'Actual Studio project UI must render.');
+            ctx.assert(['剧本', '资产库', '导演台', '成片'].every(label => text.includes(label)), 'All production stages must be available.');
+            ctx.assert(!text.includes('连接超时') && !text.includes('操作未完成'), 'Studio must connect without errors.');
+            ctx.assert(await ctx.eval(`${frame}.getBoundingClientRect().width > 200`), 'Studio must be visible.');
+          },
+          screenshot: { name: 'studio-embedded', requireText: ['幕织 Studio'] },
+        });
+    } },
+  ],
+};
